# Copy this file to clouds.yaml (gitignored) and fill in one entry per RHOSP cloud.
#
# IMPORTANT: every entry must authenticate with an APPLICATION CREDENTIAL scoped to
# the built-in `reader` role (system-reader for cross-project visibility, or
# project-reader for a single project). Never put an admin/member password here.
#
# See README.md "Create a read-only application credential" for the exact CLI
# commands to create these on each cloud, and "Get the CA certificate" for how
# to obtain each cacert file below.
#
# CA certs: put every cloud's cert file in ./ca-certs/ (same directory as this
# file and docker-compose.yml) and reference it below with the FULL ABSOLUTE
# path on THIS HOST - e.g. if this project lives at /opt/rhosp-agent, a cert
# saved as ./ca-certs/site-a-ca.pem is referenced as
# /opt/rhosp-agent/ca-certs/site-a-ca.pem. This exact absolute path must work
# both for direct `openstack` CLI testing on the host AND inside the
# tool-server container - docker-compose.yml mounts ./ca-certs at that same
# absolute path for that reason. Adding a new cloud is then just "drop its
# cert file in ./ca-certs/" - no docker-compose.yml change needed.

clouds:
  rhosp16-site-a:
    auth:
      auth_url: https://keystone.site-a.example.internal:5000/v3
      application_credential_id: "REPLACE_ME"
      application_credential_secret: "REPLACE_ME"
    auth_type: v3applicationcredential
    region_name: RegionOne
    cacert: /opt/rhosp-agent/ca-certs/site-a-ca.pem

  rhosp17-site-b:
    auth:
      auth_url: https://keystone.site-b.example.internal:5000/v3
      application_credential_id: "REPLACE_ME"
      application_credential_secret: "REPLACE_ME"
    auth_type: v3applicationcredential
    region_name: RegionOne
    cacert: /opt/rhosp-agent/ca-certs/site-b-ca.pem

  rhosp18-site-c:
    auth:
      auth_url: https://keystone.site-c.example.internal:5000/v3
      application_credential_id: "REPLACE_ME"
      application_credential_secret: "REPLACE_ME"
    auth_type: v3applicationcredential
    region_name: RegionOne
    cacert: /opt/rhosp-agent/ca-certs/site-c-ca.pem
